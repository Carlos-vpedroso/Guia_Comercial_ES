model Contact {
  id   String      @id @default(cuid())
  url  String
  type ContactType

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@map("contacts")
}

enum ContactType {
  PHONE
  EMAIL
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  WEBSITE
}
