model Image {
  id         String  @id @default(cuid())
  url        String
  storageKey String
  isCover    Boolean @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("images")
}
